{
  "name": "topkyo-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.5.0"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-better-sqlite3.mjs",
    "prebuild": "node scripts/assert-no-next-dev.mjs",
    "predev": "node scripts/ensure-better-sqlite3.mjs",
    "prestart": "node scripts/ensure-better-sqlite3.mjs && node scripts/fix-next-server-chunks.mjs",
    "dev": "next dev -H 127.0.0.1",
    "build": "rm -rf .next && next build && node scripts/fix-next-server-chunks.mjs",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test --import tsx test/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
